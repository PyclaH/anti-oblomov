<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Шаг 1: чтобы узнать название YouTube для экрана блокировки.
        На шаге 3 заменим на видимость всех приложений с иконкой на рабочем столе.
    -->
    <queries>
        <package android:name="com.google.android.youtube" />
    </queries>

    <!--
        Приёмник загрузки. На HyperOS настройка «Автозапуск» обычно показывается
        только у приложений, которые реагируют на системные события, — проверяем,
        появится ли она.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AntiOblomov">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Служба блокировки. Подключить её может только система
            (разрешение BIND_ACCESSIBILITY_SERVICE есть только у Android).
            Работает в отдельном процессе «:blocking»: когда приложение смахивают
            из недавних, система закрывает процесс интерфейса — служба при этом
            может уцелеть (проверка шага 1, раунд 3).
        -->
        <service
            android:name=".blocking.BlockingService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:process=":blocking">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <receiver
            android:name=".blocking.BootReceiver"
            android:exported="true"
            android:process=":blocking">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
